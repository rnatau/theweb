option(WEB_BUILD_GAMES "Build desktop games and development hosts" ON)
option(WEB_BUILD_LINUX_HOST "Build Linux desktop adapters" ON)
option(WEB_REFERENCE_TOOLS "Build original-dependent research fixture drivers" OFF)
option(WEB_DESKTOP_TESTS "Register tests using desktop/audio devices" OFF)
option(WEB_SANITIZERS "Enable address and undefined-behavior sanitizers" OFF)
option(WEB_STATIC_RUNTIME "Link the MinGW compiler runtime statically" OFF)
set(WEB_EDITION "both" CACHE STRING "Edition to build: both, classic or enhanced")
set_property(CACHE WEB_EDITION PROPERTY STRINGS both classic enhanced)
set(WEB_OUTPUT_DIRECTORY "" CACHE PATH "Optional legacy output layout")
if(NOT WEB_EDITION MATCHES "^(both|classic|enhanced)$")
    message(FATAL_ERROR "Invalid WEB_EDITION")
endif()
set(asset_tests_default OFF)
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT" AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/native/tests/gameplay_driver.cpp")
    set(asset_tests_default ON)
endif()
option(WEB_ASSET_TESTS "Build tests requiring privately supplied game data" ${asset_tests_default})
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(MSVC)
    add_compile_options(/W4 /permissive- "$<$<OR:$<CONFIG:Release>,$<CONFIG:MinSizeRel>>:/Z7>")
    add_link_options("$<$<OR:$<CONFIG:Release>,$<CONFIG:MinSizeRel>>:/DEBUG>")
else()
    add_compile_options(-Wall -Wextra -Wpedantic -g)
endif()
if(WEB_SANITIZERS)
    if(MSVC)
        add_compile_options(/fsanitize=address)
    else()
        add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer)
        add_link_options(-fsanitize=address,undefined)
    endif()
endif()
if(MINGW AND WEB_STATIC_RUNTIME)
    add_link_options(-static -static-libgcc -static-libstdc++)
endif()
if(WEB_OUTPUT_DIRECTORY)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${WEB_OUTPUT_DIRECTORY}")
endif()

# Single-config builds default to a shipping configuration. Explicit Debug and
# RelWithDebInfo builds remain available for development on either platform.
if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()

# The recovered engine and software renderers are usable without a GUI backend.
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/native/core-sources.txt" WEB_CORE_SOURCES)
list(TRANSFORM WEB_CORE_SOURCES PREPEND "native/")
add_library(web_core STATIC ${WEB_CORE_SOURCES})
target_compile_features(web_core PUBLIC cxx_std_20)
target_include_directories(web_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/native")
set_target_properties(web_core PROPERTIES CXX_EXTENSIONS OFF)

find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_FOUND)
    add_custom_target(check-native-boundaries ALL
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/check-native-boundaries.py" --edition ${WEB_EDITION}
        VERBATIM)
    add_custom_target(check-native-core
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/check-native-boundaries.py" --edition core
        VERBATIM)
    add_dependencies(web_core check-native-core)
endif()

