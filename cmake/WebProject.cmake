if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND WEB_BUILD_GAMES AND WEB_BUILD_LINUX_HOST)
    find_path(SDL2_INCLUDE_DIR SDL.h PATH_SUFFIXES SDL2 REQUIRED)
    find_library(SDL2_LIBRARY NAMES SDL2 REQUIRED)
    find_path(MPG123_INCLUDE_DIR mpg123.h REQUIRED)
    find_library(MPG123_LIBRARY NAMES mpg123 REQUIRED)
    add_library(web_linux_dependencies INTERFACE)
    target_include_directories(web_linux_dependencies SYSTEM INTERFACE "${SDL2_INCLUDE_DIR}" "${MPG123_INCLUDE_DIR}")
    target_link_libraries(web_linux_dependencies INTERFACE "${SDL2_LIBRARY}" "${MPG123_LIBRARY}")
    find_package(Threads REQUIRED)
    add_library(web_linux_host STATIC
        native/platform/linux/application.cpp
        native/platform/linux/audio.cpp
        native/platform/linux/save_storage.cpp)
    target_link_libraries(web_linux_host PUBLIC web_core web_linux_dependencies Threads::Threads)
    # Build-tree launch works from an unrelated CWD, just like a portable package.
    if(CMAKE_HOST_UNIX)
        file(CREATE_LINK "${CMAKE_CURRENT_SOURCE_DIR}/data" "${CMAKE_BINARY_DIR}/data" SYMBOLIC)
    endif()
    if(BUILD_TESTING)
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/development")
        if(CMAKE_HOST_UNIX)
            file(CREATE_LINK "${CMAKE_CURRENT_SOURCE_DIR}/data" "${CMAKE_BINARY_DIR}/development/data" SYMBOLIC)
        endif()
        add_executable(linux-storage-tests native/tests/linux_storage_tests.cpp native/platform/linux/save_storage.cpp)
        target_link_libraries(linux-storage-tests PRIVATE web_core)
        add_test(NAME linux-storage COMMAND linux-storage-tests)
        if(WEB_ASSET_TESTS)
        add_executable(linux-audio-tests native/tests/linux_audio_tests.cpp native/platform/linux/audio.cpp)
        target_link_libraries(linux-audio-tests PRIVATE web_core web_linux_dependencies Threads::Threads)
        add_test(NAME linux-audio COMMAND linux-audio-tests "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        set_tests_properties(linux-audio PROPERTIES ENVIRONMENT "SDL_AUDIODRIVER=dummy" TIMEOUT 120)
        endif()
    endif()
