if(WEB_EDITION STREQUAL "both")
    set(web_editions classic enhanced)
else()
    set(web_editions ${WEB_EDITION})
endif()
foreach(edition IN LISTS web_editions)
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/native/editions/${edition}/sources.txt" EDITION_SOURCES)
    list(TRANSFORM EDITION_SOURCES PREPEND "native/")
    add_library(web_${edition} STATIC ${EDITION_SOURCES})
    target_link_libraries(web_${edition} PUBLIC web_core)
    if(Python3_FOUND)
        add_custom_target(check-native-${edition}
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/check-native-boundaries.py" --edition ${edition}
            VERBATIM)
        add_dependencies(web_${edition} check-native-${edition})
    endif()
    if(edition STREQUAL "classic")
        set(application theweb)
    else()
        set(application theweb-enhanced)
    endif()
    if(WIN32 AND WEB_BUILD_GAMES)
        add_executable(${application} WIN32 native/platform/win32/main.cpp)
        target_link_libraries(${application} PRIVATE web_${edition} web_windows_host web_windows_audio_${edition} web_windows_presentation_${edition} shell32)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND WEB_BUILD_GAMES AND WEB_BUILD_LINUX_HOST)
        add_executable(${application} native/platform/linux/main.cpp)
        target_link_libraries(${application} PRIVATE web_${edition} web_linux_host)
        install(TARGETS ${application} RUNTIME DESTINATION .)
    endif()
    if(TARGET ${application})
        if(MINGW AND BUILD_TESTING)
            set(map_directory "${CMAKE_BINARY_DIR}/development/${edition}")
            if(WEB_OUTPUT_DIRECTORY)
                set(map_directory "${WEB_OUTPUT_DIRECTORY}/development/${edition}")
            endif()
            file(MAKE_DIRECTORY "${map_directory}")
            target_link_options(${application} PRIVATE "-Wl,-Map,${map_directory}/theweb.map,--demangle")
        endif()
        if(MSVC)
            target_link_options(${application} PRIVATE "$<$<OR:$<CONFIG:Release>,$<CONFIG:MinSizeRel>>:/DEBUG:NONE>")
        else()
            target_link_options(${application} PRIVATE "$<$<OR:$<CONFIG:Release>,$<CONFIG:MinSizeRel>>:-s>")
        endif()
    endif()
    if(BUILD_TESTING AND WEB_ASSET_TESTS)
        if(WIN32 AND WEB_BUILD_GAMES)
            add_executable(theweb-tools-${edition} WIN32 native/platform/win32/tools_main.cpp)
            target_link_libraries(theweb-tools-${edition} PRIVATE web_${edition} web_windows_host web_windows_audio_${edition} web_windows_presentation_${edition})
            set(development_directory "${CMAKE_BINARY_DIR}/development/${edition}")
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND WEB_BUILD_GAMES AND WEB_BUILD_LINUX_HOST)
            add_executable(theweb-tools-${edition} native/platform/linux/tools_main.cpp)
            target_link_libraries(theweb-tools-${edition} PRIVATE web_${edition} web_linux_host)
            set(development_directory "${CMAKE_BINARY_DIR}/development/${edition}")
        endif()
        if(TARGET theweb-tools-${edition})
            set_target_properties(theweb-tools-${edition} PROPERTIES
                RUNTIME_OUTPUT_DIRECTORY "${development_directory}" OUTPUT_NAME theweb-tools)
        endif()
        add_executable(edition-tests-${edition} native/tests/edition_tests.cpp)
        target_link_libraries(edition-tests-${edition} PRIVATE web_${edition})
        add_test(NAME edition-${edition} COMMAND edition-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        add_executable(flipper-spacing-tests-${edition} native/tests/flipper_spacing_tests.cpp)
        target_link_libraries(flipper-spacing-tests-${edition} PRIVATE web_${edition})
        add_test(NAME flipper-spacing-${edition} COMMAND flipper-spacing-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        add_executable(mode-tests-${edition} native/tests/mode_collection_tests.cpp)
        target_link_libraries(mode-tests-${edition} PRIVATE web_${edition})
        add_test(NAME modes-${edition} COMMAND mode-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        add_executable(nudge-tests-${edition} native/tests/nudge_physics_tests.cpp)
        target_link_libraries(nudge-tests-${edition} PRIVATE web_${edition})
        add_test(NAME nudge-${edition} COMMAND nudge-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        add_executable(input-tests-${edition} native/tests/timestamped_input_tests.cpp)
        target_link_libraries(input-tests-${edition} PRIVATE web_${edition})
        add_test(NAME input-${edition} COMMAND input-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        add_executable(record-tests-${edition} native/tests/record_policy_tests.cpp)
        target_link_libraries(record-tests-${edition} PRIVATE web_${edition})
        add_test(NAME records-${edition} COMMAND record-tests-${edition} "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
        if(edition STREQUAL "enhanced")
            add_executable(incremental-tests native/tests/incremental_tests.cpp)
            target_link_libraries(incremental-tests PRIVATE web_enhanced)
            add_test(NAME incremental COMMAND incremental-tests "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
            add_executable(enhanced-menu-tests native/tests/enhanced_menu_tests.cpp)
            target_link_libraries(enhanced-menu-tests PRIVATE web_enhanced)
            add_test(NAME enhanced-menu COMMAND enhanced-menu-tests "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
            add_executable(enhanced-start-tests native/tests/enhanced_start_tests.cpp)
            target_link_libraries(enhanced-start-tests PRIVATE web_enhanced)
            add_test(NAME enhanced-start COMMAND enhanced-start-tests "${CMAKE_CURRENT_SOURCE_DIR}/data/PC_DAT")
            add_executable(enhanced-presentation-tests native/tests/enhanced_presentation_tests.cpp)
            target_link_libraries(enhanced-presentation-tests PRIVATE web_enhanced)
            add_test(NAME enhanced-presentation COMMAND enhanced-presentation-tests)
        endif()
        if(MSVC AND WIN32 AND TARGET theweb-tools-${edition})
            target_link_options(theweb-tools-${edition} PRIVATE /ENTRY:mainCRTStartup)
        endif()
    endif()
    if(MSVC AND TARGET ${application})
        target_link_options(${application} PRIVATE /ENTRY:mainCRTStartup)
    endif()
    if(WEB_OUTPUT_DIRECTORY AND BUILD_TESTING AND WEB_ASSET_TESTS)
        foreach(kind IN ITEMS edition flipper-spacing mode nudge input record)
            set_target_properties(${kind}-tests-${edition} PROPERTIES
                RUNTIME_OUTPUT_DIRECTORY "${WEB_OUTPUT_DIRECTORY}/development/${edition}"
                OUTPUT_NAME "${kind}-tests")
        endforeach()
        if(edition STREQUAL "enhanced")
            foreach(kind IN ITEMS menu start presentation)
                set_target_properties(enhanced-${kind}-tests PROPERTIES
                    RUNTIME_OUTPUT_DIRECTORY "${WEB_OUTPUT_DIRECTORY}/development/enhanced"
                    OUTPUT_NAME "${kind}-tests")
            endforeach()
        endif()
        if(TARGET theweb-tools-${edition})
            set_target_properties(theweb-tools-${edition} PROPERTIES
                RUNTIME_OUTPUT_DIRECTORY "${WEB_OUTPUT_DIRECTORY}/development/${edition}")
        endif()
    endif()
endforeach()

